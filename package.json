{
  "name": "awasebin", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1", "dev:api": "node --env-file=.env --watch server/main.mjs",
    "build": "node scripts/browser-assets.mjs && tsc --noEmit && vite build", "start": "node --env-file=.env server/main.mjs",
    "prepare:browser": "node scripts/browser-assets.mjs",
    "migrate": "node --env-file=.env server/cli.mjs migrate",
    "bootstrap": "node --env-file=.env server/cli.mjs bootstrap",
    "cleanup": "node --env-file=.env server/cli.mjs cleanup",
    "seeder": "node --env-file=.env server/seeder.mjs",
    "tracker": "node --env-file=.env server/tracker.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2", "@fastify/rate-limit": "^10.3.0", "@fastify/swagger": "^9.5.1",
    "@simplewebauthn/browser": "^13.2.2", "@simplewebauthn/server": "^13.2.2",
    "fastify": "^5.6.1", "pg": "^8.16.3", "react": "^19.1.1", "react-dom": "^19.1.1",
    "tus-js-client": "^4.3.1", "webtorrent": "2.8.5", "ws": "^8.18.3", "hash-wasm": "^4.12.0", "sharp": "^0.34.4",
    "create-torrent": "^6.1.0", "parse-torrent": "^11.0.18"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10", "@types/react": "^19.1.16", "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4", "typescript": "^5.9.3", "vite": "^7.1.9"
  }
}
