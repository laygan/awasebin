[Unit]
Description=Awasebin encrypted metadata backup
After=postgresql.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/cosshare
EnvironmentFile=/etc/cosshare/app.env
ExecStart=/usr/bin/node /opt/cosshare/scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/backups/cosshare
