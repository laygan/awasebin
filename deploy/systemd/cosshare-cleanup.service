[Unit]
Description=Awasebin expiry and retention cleanup
After=postgresql.service cosshare-api.service
RequiresMountsFor=/srv/cosshare
[Service]
Type=oneshot
User=cosshare
Group=cosshare
WorkingDirectory=/opt/cosshare
EnvironmentFile=/etc/cosshare/app.env
ExecStart=/usr/bin/node /opt/cosshare/server/cli.mjs cleanup
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/cosshare
